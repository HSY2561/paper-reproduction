# Publish only the curated top-level directories; old local mirrors stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/configs/
!/docs/
!/evidence/
!/figures/
!/overlays/
!/requirements/
!/results/
!/runtime/
!/scripts/
!/third_party/
# Local dependencies and outputs; source packages named datasets are intentionally allowed.
/.cache/
/.local_runs/
/data/
/artifacts/
/runs/
/outputs/
/.venv/
/venv/
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
id_rsa*
*.pdparams
*.pdopt
*.pdstates
*.pth
*.pt
*.ckpt
*.onnx
*.tar
*.tar.gz
*.zip
*.whl
*.log
.DS_Store
Thumbs.db
